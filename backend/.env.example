# Application Settings
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database (Neon Connection String Template)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Authentication & OAuth 2.0 Secrets
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# ── Google OAuth 2.0 Credentials ──
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# ── Mail Transport Settings (Nodemailer SMTPS) ──
# NOTE: Render and most PaaS providers block outbound SMTP (ports 465/587).
# Set RESEND_API_KEY to use Resend HTTPS API instead — required for production.
MAIL_MODE=gmail
MAIL_USER=your-email@gmail.com
MAIL_PASS="your-app-password"
MAIL_FROM_NAME="ManMadhan Progress"
MAIL_FROM_ADDRESS=your-email@gmail.com

# ── Generic SMTP Provider (local/self-hosted only) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS="your-app-password"
EMAIL_FROM="ManMadhan Progress <your-email@gmail.com>"

# ── Resend HTTPS Email API (REQUIRED on Render / Vercel / Railway) ──
# Register at https://resend.com — free tier includes 3,000 emails/month.
# When RESEND_API_KEY is set, Nodemailer/SMTP config is ignored entirely.
RESEND_API_KEY=re_your_resend_api_key_here

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Firebase Cloud Messaging & Admin SDK
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# ── Artificial Intelligence & LLM API Keys ──
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Realtime WebSocket & Redis Engine
SOCKET_CORS_ORIGIN=http://localhost:3000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Pino Logging
LOG_LEVEL=debug

# ── Integration Hub ──
TOKEN_ENCRYPTION_KEY="your-32-byte-hex-string-here"
FRONTEND_URL="http://localhost:3000"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/personal/integrations/GoogleCalendar/callback"
GITHUB_REDIRECT_URI="http://localhost:4000/api/v1/personal/integrations/GitHub/callback"
