{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./config/*"],
      "@database/*": ["./database/*"],
      "@storage/*": ["./storage/*"]
    }
  },
  "include": ["src/**/*", "config/**/*", "database/**/*", "storage/**/*"],
  "exclude": ["node_modules", "dist"]
}
