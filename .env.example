# Environment Variables Example (Placeholder Values Only)

# Application Settings
NODE_ENV=development
PORT=4100
CLIENT_URL=http://localhost:3000

# PostgreSQL Database (Neon Connection String)
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=verify-full"

# Authentication & OAuth Secrets
BETTER_AUTH_SECRET=your-32-char-better-auth-secret
JWT_SECRET=your-32-char-jwt-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-32-char-refresh-secret
JWT_REFRESH_EXPIRATION=7d

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Mail Transport Settings
MAIL_MODE=smtp
MAIL_USER=notifications@yourdomain.com
MAIL_PASS=your-smtp-app-password
MAIL_FROM_NAME="ManMadhan Progress"
MAIL_FROM_ADDRESS=notifications@yourdomain.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your-smtp-app-password
RESEND_API_KEY=re_your_resend_api_key

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Firebase Cloud Messaging
FCM_PROJECT_ID=your-fcm-project-id
FCM_CLIENT_EMAIL=your-firebase-client-email
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# AI Provider Keys
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
